{
  "name": "yukpomnang-mobile-new",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run",
    "postinstall": "node postinstall.js",
    "clean": "node scripts/clean-build.js",
    "prebuild:clean": "npm run clean",
    "eas:build": "npm run clean && eas build",
    "configure-build": "node scripts/configure-build.js",
    "detox:build:android": "expo prebuild -p android && cd android && ./gradlew assembleDebug assembleAndroidTest -DtestBuildType=debug && cd ..",
    "detox:test:android": "detox test -c android.emu.debug",
    "detox:build:ios": "expo prebuild -p ios && cd ios && xcodebuild -workspace Yukpomnang.xcworkspace -scheme Yukpomnang -configuration Debug -sdk iphonesimulator -derivedDataPath ../ios/build && cd ..",
    "detox:test:ios": "detox test -c ios.sim.debug",
    "maestro:test": "maestro test maestro/flows",
    "i18n:sync-bourse-keys": "node scripts/sync-locale-keys-from-fr.mjs",
    "i18n:sync-product-video-modal": "node scripts/sync-productVideoCreationModal-from-en.mjs"
  },
