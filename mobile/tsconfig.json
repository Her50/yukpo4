{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@components/*": [
        "src/components/*"
      ],
      "@screens/*": [
        "src/screens/*"
      ],
      "@services/*": [
        "src/services/*"
      ],
      "@contexts/*": [
        "src/contexts/*"
      ],
      "@utils/*": [
        "src/utils/*"
      ],
      "@theme/*": [
        "src/theme/*"
      ],
      "@hooks/*": [
        "src/hooks/*"
      ],
      "@lib/*": [
        "src/lib/*"
      ],
      "@config/*": [
        "src/config/*"
      ],
      "@routes/*": [
        "src/routes/*"
      ],
      "@types/*": [
        "src/types/*"
      ]
    }
  },
  "exclude": [
    "src/legacy",
    "src/legacy/**",
    "**/*.backup.tsx",
    "App.MINIMAL-CRASH-TEST.tsx",
    "App.MINIMAL-TEST.tsx",
    "App.simple.tsx",
    "App.test.tsx",
    "App.ULTRA_MINIMAL.tsx",
    "App.tsx.backup",
    "App.tsx.backup-current",
    "App.complex.tsx.backup",
    "log-analyzer.js",
    "vitest.config.ts"
  ]
}