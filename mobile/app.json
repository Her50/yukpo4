{
    "expo": {
        "name": "Yukpo",
        "slug": "yukpomnang-mobile-new",
        "version": "1.0.0",
        "orientation": "portrait",
        "userInterfaceStyle": "automatic",
        "icon": "./assets/icon.png",
        "splash": {
            "image": "./assets/splash.png",
            "resizeMode": "contain",
            "backgroundColor": "#ffffff"
        },
        "assetBundlePatterns": [
            "assets/**/*"
        ],
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.hernandezlele.yukpomnangmobile",
            "buildNumber": "1.0.0",
            "infoPlist": {
                "NSCameraUsageDescription": "Yukpomnang a besoin d'accéder à votre caméra pour les appels vidéo.",
                "NSMicrophoneUsageDescription": "Yukpomnang a besoin d'accéder à votre microphone pour les appels audio et vidéo."
            },
            "usesApnsForNotifications": true
        },
        "android": {
            "package": "com.hernandezlele.yukpomnangmobile",
            "versionCode": 1,
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#ffffff"
            },
            "config": {
                "googleMaps": {
                    "apiKey": "AIzaSyDFfWEq1Umm06SNTbR-cRhRQ5Sq_taEAWQ"
                }
            },
            "googleServicesFile": "./google-services.json",
            "useNextNotificationsApi": true,
            "permissions": [
                "ACCESS_FINE_LOCATION",
                "ACCESS_COARSE_LOCATION",
                "CAMERA",
                "READ_EXTERNAL_STORAGE",
                "WRITE_EXTERNAL_STORAGE",
                "RECORD_AUDIO",
                "MODIFY_AUDIO_SETTINGS",
                "INTERNET",
                "ACCESS_NETWORK_STATE",
                "ACCESS_WIFI_STATE",
                "BLUETOOTH",
                "BLUETOOTH_ADMIN",
                "BLUETOOTH_CONNECT",
                "POST_NOTIFICATIONS",
                "RECEIVE_BOOT_COMPLETED",
                "VIBRATE"
            ]
        },
        "web": {
            "bundler": "metro"
        },
        "plugins": [
            [
                "expo-build-properties",
                {
                    "android": {
                        "kotlinVersion": "2.0.0",
                        "enableProguardInReleaseBuilds": false,
                        "enableShrinkResourcesInReleaseBuilds": false,
                        "useLegacyPackaging": false
                    }
                }
            ],
            "expo-location",
            "expo-image-picker",
            "expo-document-picker",
            [
                "expo-av",
                {
                    "microphonePermission": "Autoriser Yukpomnang à accéder au microphone pour enregistrer des messages audio."
                }
            ],
            [
                "expo-notifications",
                {
                    "icon": "./assets/notification-icon.png",
                    "color": "#6366F1",
                    "sounds": ["./assets/sounds/call_ringtone.mp3"],
                    "androidMode": "default",
                    "androidCollapsedTitle": "Yukpomnang"
                }
            ],
            "expo-font"
        ],
        "updates": {
            "enabled": false,
            "fallbackToCacheTimeout": 0
        },
        "extra": {
            "eas": {
                "projectId": "a5407780-d5ad-45fa-8b72-a673d3828b93"
            }
        },
        "owner": "hernandezlele",
        "scheme": "yukpomnang",
        "privacy": "public"
    }
}