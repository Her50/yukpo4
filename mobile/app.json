{
    "expo": {
        "name": "Yukpo",
        "slug": "yukpomnang-mobile-new",
        "version": "1.0.0",
        "orientation": "portrait",
        "userInterfaceStyle": "automatic",
        "icon": "./assets/icon.png",
        "splash": {
            "image": "./assets/splash.png",
            "resizeMode": "contain",
            "backgroundColor": "#ffffff"
        },
        "assetBundlePatterns": [
            "assets/**/*"
        ],
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.hernandezlele.yukpomnangmobile",
            "buildNumber": "1.0.0"
        },
        "android": {
            "package": "com.hernandezlele.yukpomnangmobile",
            "versionCode": 1,
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#ffffff"
            },
            "permissions": [
                "ACCESS_FINE_LOCATION",
                "ACCESS_COARSE_LOCATION",
                "CAMERA",
                "READ_EXTERNAL_STORAGE",
                "WRITE_EXTERNAL_STORAGE",
                "RECORD_AUDIO",
                "INTERNET",
                "ACCESS_NETWORK_STATE",
                "ACCESS_WIFI_STATE"
            ]
        },
        "web": {
            "bundler": "metro"
        },
        "plugins": [
            "expo-location",
            "expo-image-picker",
            "expo-document-picker",
            [
                "expo-av",
                {
                    "microphonePermission": "Autoriser Yukpomnang à accéder au microphone pour enregistrer des messages audio."
                }
            ],
            "expo-font"
        ],
        "extra": {
            "eas": {
                "projectId": "a5407780-d5ad-45fa-8b72-a673d3828b93"
            }
        },
        "owner": "hernandezlele",
        "scheme": "yukpomnang",
        "privacy": "public"
    }
}