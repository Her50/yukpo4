# ============================================
# DEPENDENCIES - EXCLUS COMPLÈTEMENT
# ============================================
node_modules/
**/node_modules/
# Exemples et builds dans node_modules (volumineux - CRITIQUE!)
node_modules/**/example/
node_modules/**/examples/
node_modules/**/example/**
node_modules/**/examples/**
# Tous les dossiers build dans node_modules (très volumineux!)
node_modules/**/build/
node_modules/**/build/**
node_modules/**/android/app/build/
node_modules/**/android/app/build/**
node_modules/**/android/build/
node_modules/**/android/build/**
node_modules/**/ios/build/
node_modules/**/ios/build/**
node_modules/**/build/intermediates/
node_modules/**/build/intermediates/**
node_modules/**/build/outputs/
node_modules/**/build/outputs/**
node_modules/**/build/tmp/
node_modules/**/build/tmp/**
node_modules/**/build/kotlin/
node_modules/**/build/kotlin/**
node_modules/**/.gradle/
node_modules/**/.gradle/**
# Source maps volumineux (TensorFlow, etc.)
node_modules/**/*.map
# Binaires non-Android (win64, osx, etc.)
node_modules/**/win64-bin/
node_modules/**/osx-bin/
node_modules/**/win32-*/
node_modules/**/darwin-*/
node_modules/**/*.exe
node_modules/**/*.dll
node_modules/**/*.dylib
# APK/AAB dans node_modules
node_modules/**/*.apk
node_modules/**/*.aab
# Archives volumineuses
node_modules/**/*.tbz
node_modules/**/*.tar.gz
# EXCLUSION AGRESSIVE DE TOUS LES BUILD (nouveau)
**/build/
**/build/**

