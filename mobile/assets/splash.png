<svg width="400" height="400" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
  <!-- Background gradient -->
  <defs>
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FEF3C7;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#FFFFFF;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#FCE7F3;stop-opacity:1" />
    </linearGradient>
    
    <!-- Yukpo brand colors -->
    <linearGradient id="yukpoGradient" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#F59E0B;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#DC2626;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="400" height="400" fill="url(#bgGradient)" />
  
  <!-- Logo container -->
  <circle cx="200" cy="180" r="80" fill="white" stroke="#E5E7EB" stroke-width="2" opacity="0.9" />
  
  <!-- Yukpo text -->
  <text x="200" y="185" font-family="Arial, sans-serif" font-size="32" font-weight="bold" text-anchor="middle" fill="url(#yukpoGradient)">
    Yukpo
  </text>
  
  <!-- Subtitle -->
  <text x="200" y="220" font-family="Arial, sans-serif" font-size="14" text-anchor="middle" fill="#6B7280">
    Assistant Intelligent
  </text>
  
  <!-- Decorative elements -->
  <circle cx="120" cy="120" r="4" fill="#F59E0B" opacity="0.3" />
  <circle cx="280" cy="120" r="6" fill="#DC2626" opacity="0.3" />
  <circle cx="100" cy="280" r="5" fill="#F59E0B" opacity="0.3" />
  <circle cx="300" cy="280" r="3" fill="#DC2626" opacity="0.3" />
  
  <!-- Loading indicator -->
  <circle cx="200" cy="320" r="3" fill="#0F52BA" opacity="0.8" />
  <circle cx="210" cy="320" r="3" fill="#0F52BA" opacity="0.6" />
  <circle cx="220" cy="320" r="3" fill="#0F52BA" opacity="0.4" />
  <circle cx="190" cy="320" r="3" fill="#0F52BA" opacity="0.6" />
  <circle cx="180" cy="320" r="3" fill="#0F52BA" opacity="0.4" />
</svg>
