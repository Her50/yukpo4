# 🚀 Yukpo Backend - Production Environment
# ⚠️ CE FICHIER CONTIENT LES VALEURS DE PRODUCTION
# NE PAS COMMITTER LES VRAIES VALEURS - UTILISER LES SECRETS GCP

# 🔐 BASE DE DONNÉES
DATABASE_URL=postgresql://user:pass@host:5432/db

# 🔄 REDIS
REDIS_URL=redis://host:port/db

# 🔐 SÉCURITÉ
JWT_SECRET=production_jwt_secret_here

# 🤖 IA OPENAI
OPENAI_API_KEY=sk-production-openai-key

# 🌍 GÉOLOCALISATION
GOOGLE_MAPS_API_KEY=production-google-maps-key

# ☁️ DÉPLOIEMENT GCP
CLOUD_RUN=true
PORT=8080
LOG_LEVEL=info

# 🗃️ OPTIMISATIONS BASE DE DONNÉES
DB_POOL_SIZE=100
DB_POOL_MIN_SIZE=20
DB_ACQUIRE_TIMEOUT_SECS=30

# 🔄 CACHE
CACHE_TTL_SEARCH=600
RATE_LIMIT_IP=200

# 🤖 OPTIMISATIONS IA (NOUVEAU 2026-03-17)
OPENAI_MODEL=gpt-4o
VISION_MODEL_PRIORITY=10
COST_THRESHOLD_PER_DAY=50
DAILY_USAGE_LIMIT=1000
SEMANTIC_CACHE_ENABLED=true
ENABLE_BATCH_REQUESTS=true

# 📊 MONITORING
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true

# 🌍 INTERNATIONALISATION
DEFAULT_LANGUAGE=fr
SUPPORTED_LANGUAGES=fr,en,es,de,ar,ha,yo,sw,zh,hi,ja,ru,pt,it,nl,tr,am,wo,zu,ig,ln,ff,rw,sn,so,ti,mg,ht,pap,ewo,dua,bbj,bas,bum,bci,dyu,bet,pcm,mos,bm,dje,ee,kbp,sar,sg,kg,lua,fan,xh,af,st,rn,srr,bn,tl,ms,uk,pl,vi,th,id