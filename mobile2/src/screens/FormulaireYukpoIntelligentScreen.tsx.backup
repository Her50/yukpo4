import AsyncStorage from '@react-native-async-storage/async-storage';
// @ts-ignore
import { useNavigation, useRoute } from '@react-navigation/native';
// @ts-ignore
import { LinearGradient } from 'expo-linear-gradient';
import React, { useEffect, useState } from 'react';
// @ts-ignore
import {
  ActivityIndicator,
  Alert,
  Dimensions,
  ScrollView,
  StyleSheet,
  Text,
  TouchableOpacity,
  View,
} from 'react-native';
// @ts-ignore
import EnhancedGPSModal from '../components/EnhancedGPSModal';
// @ts-ignore
import { NativeBadge, NativeButton, NativeCard, NativeDivider, NativeInput } from '../components/NativeDesign';
// @ts-ignore
import SafeIcon from '../components/SafeIcon';
// @ts-ignore
import { useAuth } from '../contexts/AuthContext';
// @ts-ignore
import { appelerMoteurIA } from '../lib/yukpoaclient';
// @ts-ignore
import { apiGet, apiPost } from '../services/api';
// @ts-ignore
import { modernColors, modernStyles } from '../theme/modernTheme';
// @ts-ignore
import { DynamicField, extractSuggestionValues, IASuggestion, processIASuggestion } from '../utils/formDispatcher';

const { width } = Dimensions.get('window');

// Interface DynamicField déjà importée depuis formDispatcher

interface ServiceData {
  serviceId?: string;
  cout?: number;
}

interface MediaFiles {
  images: any[];
  audios: any[];
  videos: any[];
  documents: any[];
  excel: any[];
  logo: any[];
  banner: any[];
}

const FormulaireYukpoIntelligentScreen: React.FC = () => {
  const navigation = useNavigation();
  const route = useRoute();
  const { user } = useAuth();

  // État des données reçues
  const suggestion = (route.params as any)?.suggestion || {};
  const mediaData = (route.params as any)?.mediaData || {};
  const gpsData = (route.params as any)?.gpsData || {};
  const type = (route.params as any)?.type || '';
  const mode = (route.params as any)?.mode || 'edit';
  const serviceId = (route.params as any)?.serviceId;
  const fromMesServices = (route.params as any)?.fromMesServices || false;
  const focusPromotion = (route.params as any)?.focusPromotion || false;

  // États locaux
  const [activeStep, setActiveStep] = useState(1);
  const [composants, setComposants] = useState<DynamicField[]>([]);
  const [loading, setLoading] = useState(false);
  const [valeursFormulaire, setValeursFormulaire] = useState<Record<string, any>>({});
  const [showGPSModal, setShowGPSModal] = useState(false);
  const [selectedLocation, setSelectedLocation] = useState<{ lat: number; lng: number } | null>(null);
  const [showProductManager, setShowProductManager] = useState(false);
  const [products, setProducts] = useState<any[]>([]);
  const [mediaFiles, setMediaFiles] = useState<MediaFiles>({
    images: mediaData.base64_image || [],
    audios: mediaData.audio_base64 || [],
    videos: mediaData.video_base64 || [],
    documents: mediaData.doc_base64 || [],
    excel: mediaData.excel_base64 || [],
    logo: mediaData.logo || [],
    banner: mediaData.banner || []
  });
  const [gps, setGps] = useState<string | undefined>(undefined);
  const [showSuccessToast, setShowSuccessToast] = useState(false);
  const [successData, setSuccessData] = useState<ServiceData | null>(null);
  const [promotions, setPromotions] = useState<any[]>([]);
  const [showPromotionForm, setShowPromotionForm] = useState(false);
  const [errors, setErrors] = useState<Record<string, string>>({});

  // États pour la navigation par blocs
  const [currentBlock, setCurrentBlock] = useState(0);

  // Fonction de gestion du retour
  const handleGoBack = () => {
    if (fromMesServices) {
      // Si on vient de MesServices, retourner spécifiquement à cet écran
      try {
        (navigation as any).navigate('MesServices');
      } catch (error) {
        console.error('Erreur navigation retour MesServices:', error);
        // Fallback vers le retour normal
        navigation.goBack();
      }
    } else {
      // Navigation normale
      navigation.goBack();
    }
  };
  const [blocks, setBlocks] = useState<{
    id: string;
    title: string;
    icon: string;
    fields: DynamicField[];
  }[]>([]);

  // Règles de validation
  const validationRules: Record<string, any> = {
    titre: { required: true, minLength: 3, maxLength: 100 },
    description: { required: true, minLength: 10, maxLength: 500 },
    prix: {
      required: true, custom: (value: any) => {
        const num = parseFloat(value);
        if (isNaN(num) || num < 0) return 'Le prix doit être un nombre positif';
        return null;
      }
    },
    localisation: { required: true },
    categorie: { required: true }
  };

  // Fonction pour organiser les champs en blocs (comme le frontend)
  const organizeFieldsIntoBlocks = (fields: DynamicField[]) => {
    const blocks = [
      {
        id: 'general',
        title: 'Informations générales',
        icon: '📋',
        fields: [] as DynamicField[]
      },
      {
        id: 'contact',
        title: 'Contact',
        icon: '📞',
        fields: [] as DynamicField[]
      },
      {
        id: 'location',
        title: 'Localisation',
        icon: '📍',
        fields: [] as DynamicField[]
      },
      {
        id: 'products',
        title: 'Produits/Services',
        icon: '🛍️',
        fields: [] as DynamicField[]
      },
      {
        id: 'other',
        title: 'Autres informations',
        icon: 'ℹ️',
        fields: [] as DynamicField[]
      }
    ];

    fields.forEach(field => {
      const fieldName = field.name.toLowerCase();

      if (['titre_service', 'category', 'description', 'is_tarissable'].includes(fieldName)) {
        blocks[0].fields.push(field); // Informations générales
      } else if (['whatsapp', 'telephone', 'email', 'website'].includes(fieldName)) {
        blocks[1].fields.push(field); // Contact
      } else if (fieldName === 'gps_fixe') {
        blocks[2].fields.push(field); // Localisation
      } else if (fieldName === 'liste_produits') {
        blocks[3].fields.push(field); // Produits/Services
      } else {
        blocks[4].fields.push(field); // Autres
      }
    });

    // Filtrer les blocs vides
    return blocks.filter(block => block.fields.length > 0);
  };

  // Fonctions de validation
  const validateField = (fieldName: string, value: any) => {
    const rule = validationRules[fieldName as keyof typeof validationRules];
    if (!rule) return null;

    if (rule.required && (!value || value.toString().trim() === '')) {
      return `${fieldName} est requis`;
    }

    if (rule.minLength && value && value.toString().length < rule.minLength) {
      return `${fieldName} doit contenir au moins ${rule.minLength} caractères`;
    }

    if (rule.maxLength && value && value.toString().length > rule.maxLength) {
      return `${fieldName} doit contenir au maximum ${rule.maxLength} caractères`;
    }

    if (rule.custom) {
      return rule.custom(value);
    }

    return null;
  };

  const validateForm = (data: Record<string, any>) => {
    const newErrors: Record<string, string> = {};
    let isValid = true;

    Object.keys(validationRules).forEach(fieldName => {
      const error = validateField(fieldName, data[fieldName]);
      if (error) {
        newErrors[fieldName] = error;
        isValid = false;
      }
    });

    setErrors(newErrors);
    return isValid;
  };

  const clearErrors = () => {
    setErrors({});
  };

  // Fonctions de navigation entre blocs
  const goToNextBlock = () => {
    if (currentBlock < blocks.length - 1) {
      setCurrentBlock(currentBlock + 1);
    }
  };

  const goToPreviousBlock = () => {
    if (currentBlock > 0) {
      setCurrentBlock(currentBlock - 1);
    }
  };

  const goToBlock = (blockIndex: number) => {
    if (blockIndex >= 0 && blockIndex < blocks.length) {
      setCurrentBlock(blockIndex);
    }
  };

  // Organiser les champs en blocs quand les composants changent
  useEffect(() => {
    if (composants.length > 0) {
      const organizedBlocks = organizeFieldsIntoBlocks(composants);
      setBlocks(organizedBlocks);
      console.log('[FormulaireYukpoIntelligentScreen] Blocs organisés:', organizedBlocks);
    }
  }, [composants]);

  // Charger les données du service à modifier
  useEffect(() => {
    const loadServiceData = async () => {
      if (mode === 'edit' && serviceId) {
        try {
          const response = await apiPost(`/api/services/${serviceId}`, {});
          const serviceData = response.data;

          // Pré-remplir les champs avec les données existantes
          if ((serviceData as any).data) {
            const existingValues: Record<string, any> = {};

            Object.keys((serviceData as any).data).forEach(key => {
              const fieldData = (serviceData as any).data[key];
              if (fieldData && fieldData.valeur) {
                existingValues[key] = fieldData.valeur;
              } else if (typeof fieldData === 'string') {
                existingValues[key] = fieldData;
              }
            });

            setValeursFormulaire(existingValues);
          }

          // Pré-remplir les médias si disponibles
          if ((serviceData as any).base64_image) {
            setMediaFiles(prev => ({
              ...prev,
              images: Array.isArray((serviceData as any).base64_image) ? (serviceData as any).base64_image : [(serviceData as any).base64_image]
            }));
          }
        } catch (error) {
          console.error('Erreur lors du chargement du service:', error);
          Alert.alert('Erreur', 'Erreur lors du chargement des données du service');
        }
      }
    };

    loadServiceData();
  }, [mode, serviceId]);

  // Traiter les suggestions IA reçues et charger les données du backend
  useEffect(() => {
    console.log('[FormulaireYukpoIntelligent] Traitement des suggestions IA reçues:', suggestion);

    const loadBackendData = async () => {
      try {
        // Charger les données de contact du dernier service (comme le frontend)
        const token = await AsyncStorage.getItem('auth_token');
        if (token) {
          const response = await apiGet('/api/services/last');
          if (response && response.data && Object.keys(response.data).length > 0) {
            const serviceData = response.data as any;
            const contactData = {
              whatsapp: serviceData.whatsapp?.valeur || serviceData.whatsapp || '',
              telephone: serviceData.telephone?.valeur || serviceData.telephone || '',
              email: serviceData.email?.valeur || serviceData.email || '',
              website: serviceData.website?.valeur || serviceData.website ||
                serviceData.siteweb?.valeur || serviceData.siteweb || ''
            };

            console.log('[FormulaireYukpoIntelligent] Données de contact chargées:', contactData);
            setValeursFormulaire(prev => ({
              ...prev,
              ...contactData
            }));
          }
        }
      } catch (error) {
        console.warn('[FormulaireYukpoIntelligent] Impossible de charger les contacts précédents:', error);
      }
    };

    const generateAIData = async () => {
      try {
        // Si il y a du texte saisi, appeler l'IA pour générer les données
        if (suggestion.texte && suggestion.texte.trim().length > 0) {
          console.log('[FormulaireYukpoIntelligent] Génération des données avec IA pour:', suggestion.texte);

          const donneesService = {
            texte: suggestion.texte,
            intention: 'creation_service',
            base64_image: mediaFiles.images || [],
            audio_base64: mediaFiles.audios || [],
            video_base64: mediaFiles.videos || [],
            doc_base64: mediaFiles.documents || [],
            excel_base64: mediaFiles.excel || [],
            logo: mediaFiles.logo || [],
            banner: mediaFiles.banner || []
          };

          console.log('[FormulaireYukpoIntelligent] Données envoyées à l\'IA:', donneesService);

          const iaResponse = await appelerMoteurIA(donneesService);
          console.log('[FormulaireYukpoIntelligent] Réponse IA reçue:', iaResponse);

          if (iaResponse && iaResponse.data) {
            // Traiter la réponse IA pour générer les composants
            const aiSuggestion = {
              intention: 'creation_service',
              data: iaResponse.data.service_data?.data || iaResponse.data.data || iaResponse.data,
              confidence: iaResponse.data.confidence || 0.8,
              tokens_consumed: iaResponse.data.tokens_consumed || 0
            };

            console.log('[FormulaireYukpoIntelligent] Suggestion IA traitée:', aiSuggestion);

            // Générer les composants à partir des données IA
            const generatedComponents = processIASuggestion(aiSuggestion);
            if (generatedComponents && generatedComponents.length > 0) {
              setComposants(generatedComponents);

              // Extraire et appliquer les valeurs des suggestions IA
              const suggestionValues = extractSuggestionValues(aiSuggestion);
              console.log('[FormulaireYukpoIntelligent] Valeurs IA extraites:', suggestionValues);

              setValeursFormulaire(prev => ({
                ...prev,
                ...suggestionValues
              }));

              return true; // Données IA générées avec succès
            }
          }
        }
        return false; // Pas de données IA générées
      } catch (error) {
        console.error('[FormulaireYukpoIntelligent] Erreur génération IA:', error);
        return false;
      }
    };

    const initializeForm = async () => {
      // Essayer d'abord de générer les données avec l'IA si il y a du texte
      const aiDataGenerated = await generateAIData();

      if (!aiDataGenerated) {
        // Si pas de données IA générées, utiliser les composants par défaut
        console.log('[FormulaireYukpoIntelligent] Utilisation des composants par défaut');
        const defaultComponents = processIASuggestion({} as IASuggestion);
        setComposants(defaultComponents);

        // Charger les données de contact du backend
        loadBackendData();
      }
    };

    initializeForm();
  }, [suggestion]);

  // Initialiser le GPS
  useEffect(() => {
    // Traiter les données GPS reçues depuis HomeScreen
    if (gpsData && Object.keys(gpsData).length > 0) {
      console.log('[FormulaireYukpoIntelligent] Données GPS reçues:', gpsData);

      if (gpsData.gps_fixe) {
        try {
          // Parser les coordonnées GPS
          const coords = gpsData.gps_fixe.split(',');
          if (coords.length === 2) {
            const lat = parseFloat(coords[0]);
            const lng = parseFloat(coords[1]);
            if (!isNaN(lat) && !isNaN(lng)) {
              setSelectedLocation({ lat, lng });
              setValeursFormulaire(prev => ({
                ...prev,
                gps_fixe: gpsData.gps_fixe
              }));
            }
          }
        } catch (error) {
          console.warn('[FormulaireYukpoIntelligent] Erreur parsing GPS:', error);
        }
      }
    }
  }, [gpsData]);

  // Générer le formulaire dynamique
  const genererFormulaire = async () => {
    setLoading(true);
    try {
      const input = {
        texte: suggestion.texte || '',
        media: {
          images: mediaFiles.images,
          audios: mediaFiles.audios,
          videos: mediaFiles.videos,
          documents: mediaFiles.documents,
          excel: mediaFiles.excel
        },
        gps: gps,
        type: type
      };

      const response = await apiPost('/api/services/vectorize', input);
      const { composants: newComposants } = (response.data as any);

      setComposants(newComposants || []);
      setActiveStep(2);
    } catch (error) {
      console.error('Erreur génération formulaire:', error);
      Alert.alert('Erreur', 'Impossible de générer le formulaire');
    } finally {
      setLoading(false);
    }
  };

  // Soumettre le formulaire
  const soumettreFormulaire = async () => {
    // Validation du formulaire
    const isValid = validateForm(valeursFormulaire);
    if (!isValid) {
      Alert.alert('Erreur de validation', 'Veuillez corriger les erreurs dans le formulaire');
      return;
    }

    setLoading(true);
    try {
      const donneesStructurees = {
        ...valeursFormulaire,
        media: mediaFiles,
        gps: gps,
        type: type,
        user_id: user?.id
      };

      const response = await apiPost('/api/services/create', donneesStructurees);
      const { service_id, cout } = (response.data as any);

      setSuccessData({ serviceId: service_id, cout });
      setShowSuccessToast(true);

      // Navigation vers le service créé
      setTimeout(() => {
        (navigation as any).navigate('ServiceDetail', { serviceId: service_id });
      }, 2000);
    } catch (error) {
      console.error('Erreur soumission:', error);
      Alert.alert('Erreur', 'Impossible de créer le service');
    } finally {
      setLoading(false);
    }
  };

  // Rendre un champ dynamique avec le design moderne
  const renderField = (field: DynamicField) => {
    const value = valeursFormulaire[field.name] || '';
    const fieldError = errors[field.name];

    switch (field.type) {
      case 'text':
      case 'textarea':
        return (
          <View key={field.name} style={styles.fieldContainer}>
            <View style={styles.fieldLabelContainer}>
              <Text style={styles.fieldLabel}>{field.label}</Text>
              {field.required && (
                <NativeBadge text="Requis" variant="error" size="small" />
              )}
            </View>
            <NativeInput
              value={value}
              onChangeText={(text: string) => {
                setValeursFormulaire(prev => ({ ...prev, [field.name]: text }));
                // Valider le champ en temps réel
                const error = validateField(field.name, text);
                if (error) {
                  setErrors(prev => ({ ...prev, [field.name]: error }));
                } else {
                  setErrors(prev => {
                    const newErrors = { ...prev };
                    delete newErrors[field.name];
                    return newErrors;
                  });
                }
              }}
              multiline={field.type === 'textarea'}
              placeholder={field.placeholder}
              style={fieldError && styles.fieldError}
            />
            {fieldError && (
              <View style={styles.errorContainer}>
                <SafeIcon name="x" size={14} color={modernColors.error} />
                <Text style={styles.errorText}>{fieldError}</Text>
              </View>
            )}
          </View>
        );

      case 'select':
        return (
          <View key={field.name} style={styles.fieldContainer}>
            <View style={styles.fieldLabelContainer}>
              <Text style={styles.fieldLabel}>{field.label}</Text>
              {field.required && (
                <NativeBadge text="Requis" variant="error" size="small" />
              )}
            </View>
            <ScrollView horizontal showsHorizontalScrollIndicator={false} style={styles.selectScrollView}>
              {field.options?.map((option) => (
                <TouchableOpacity
                  key={option}
                  style={[
                    styles.selectOption,
                    value === option && styles.selectOptionSelected
                  ]}
                  onPress={() => setValeursFormulaire(prev => ({ ...prev, [field.name]: option }))}
                  activeOpacity={0.8}
                >
                  {value === option && (
                    <SafeIcon name="check" size={16} color="#fff" />
                  )}
                  <Text style={[
                    styles.selectOptionText,
                    value === option && styles.selectOptionTextSelected
                  ]}>
                    {option}
                  </Text>
                </TouchableOpacity>
              ))}
            </ScrollView>
          </View>
        );

      case 'number':
        return (
          <View key={field.name} style={styles.fieldContainer}>
            <View style={styles.fieldLabelContainer}>
              <Text style={styles.fieldLabel}>{field.label}</Text>
              {field.required && (
                <NativeBadge text="Requis" variant="error" size="small" />
              )}
            </View>
            <NativeInput
              value={value.toString()}
              onChangeText={(text: string) => setValeursFormulaire(prev => ({ ...prev, [field.name]: parseFloat(text) || 0 }))}
              placeholder={field.placeholder}
              style={fieldError && styles.fieldError}
            />
            {fieldError && (
              <View style={styles.errorContainer}>
                <SafeIcon name="x" size={14} color={modernColors.error} />
                <Text style={styles.errorText}>{fieldError}</Text>
              </View>
            )}
          </View>
        );

      default:
        return null;
    }
  };

  // Écran de chargement moderne
  if (loading && activeStep === 1) {
    return (
      <LinearGradient
        colors={modernColors.primaryGradient}
        style={styles.loadingContainer}
      >
        <View style={styles.loadingContent}>
          <ActivityIndicator size="large" color="#fff" />
          <Text style={styles.loadingText}>✨ Génération du formulaire intelligent...</Text>
          <Text style={styles.loadingSubtext}>L'IA analyse vos données</Text>
        </View>
      </LinearGradient>
    );
  }

  return (
    <View style={styles.container}>
      {/* Header avec gradient */}
      <LinearGradient
        colors={modernColors.primaryGradient}
        style={styles.header}
      >
        <TouchableOpacity
          onPress={handleGoBack}
          style={styles.backButton}
        >
          <SafeIcon name="back" size={24} color="#fff" />
        </TouchableOpacity>
        <View style={styles.headerContent}>
          <Text style={styles.headerTitle}>
            {mode === 'readonly' ? 'Visualisation du service' :
              mode === 'edit' && fromMesServices ? 'Modification du service' :
                'Formulaire Intelligent'}
          </Text>
          <Text style={styles.headerSubtitle}>
            {mode === 'readonly' ? 'Mode lecture seule' :
              mode === 'edit' && fromMesServices ? 'Modification en cours' :
                'Propulsé par l\'IA Yukpo'}
          </Text>
        </View>
        <View style={styles.headerRight}>
          <NativeBadge
            text={`Étape ${activeStep}/2`}
            variant="info"
            size="small"
          />
        </View>
      </LinearGradient>

      <ScrollView
        style={styles.scrollView}
        contentContainerStyle={styles.contentContainer}
        showsVerticalScrollIndicator={false}
      >
        {activeStep === 1 && (
          <View style={styles.stepContainer}>
            {/* Card d'introduction */}
            <NativeCard style={styles.introCard}>
              <View style={styles.iconCircle}>
                <SafeIcon name="star" size={32} color={modernColors.primary} />
              </View>
              <Text style={styles.introTitle}>Formulaire Yukpo Intelligent</Text>
              <Text style={styles.introDescription}>
                Notre IA va analyser vos données et générer un formulaire personnalisé adapté à votre besoin
              </Text>
            </NativeCard>

            {/* Card des données analysées */}
            <NativeCard style={styles.dataCard}>
              <View style={styles.cardHeader}>
                <SafeIcon name="file" size={20} color={modernColors.primary} />
                <Text style={styles.cardTitle}>Données à analyser</Text>
              </View>
              <NativeDivider style={styles.divider} />

              {/* Affichage des données du backend */}
              {suggestion.data && Object.keys(suggestion.data).length > 0 ? (
                <View style={styles.dataContainer}>
                  {Object.entries(suggestion.data).map(([key, value], index) => {
                    const fieldValue = typeof value === 'object' && value !== null ? value.valeur || JSON.stringify(value) : value;
                    const fieldLabel = key.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
                    
                    return (
                      <View key={index} style={styles.dataItem}>
                        <View style={styles.dataIcon}>
                          <SafeIcon name="check-circle" size={18} color={modernColors.success} />
                        </View>
                        <View style={styles.dataContent}>
                          <Text style={styles.dataLabel}>{fieldLabel}</Text>
                          <Text style={styles.dataText} numberOfLines={2}>
                            {String(fieldValue).substring(0, 100)}
                            {String(fieldValue).length > 100 ? '...' : ''}
                          </Text>
                        </View>
                      </View>
                    );
                  })}
                </View>
              ) : suggestion.texte ? (
                <View style={styles.dataItem}>
                  <View style={styles.dataIcon}>
                    <SafeIcon name="message" size={18} color={modernColors.info} />
                  </View>
                  <View style={styles.dataContent}>
                    <Text style={styles.dataLabel}>Texte</Text>
                    <Text style={styles.dataText} numberOfLines={2}>
                      {suggestion.texte.substring(0, 100)}...
                    </Text>
                  </View>
                </View>
              ) : null}

              {mediaFiles.images.length > 0 && (
                <View style={styles.dataItem}>
                  <View style={styles.dataIcon}>
                    <SafeIcon name="image" size={18} color={modernColors.success} />
                  </View>
                  <View style={styles.dataContent}>
                    <Text style={styles.dataLabel}>Images</Text>
                    <Text style={styles.dataValue}>{mediaFiles.images.length} fichier(s)</Text>
                  </View>
                </View>
              )}

              {mediaFiles.audios.length > 0 && (
                <View style={styles.dataItem}>
                  <View style={styles.dataIcon}>
                    <SafeIcon name="play" size={18} color={modernColors.warning} />
                  </View>
                  <View style={styles.dataContent}>
                    <Text style={styles.dataLabel}>Audio</Text>
                    <Text style={styles.dataValue}>{mediaFiles.audios.length} fichier(s)</Text>
                  </View>
                </View>
              )}

              {gps && (
                <View style={styles.dataItem}>
                  <View style={styles.dataIcon}>
                    <SafeIcon name="location" size={18} color={modernColors.error} />
                  </View>
                  <View style={styles.dataContent}>
                    <Text style={styles.dataLabel}>Localisation GPS</Text>
                    <Text style={styles.dataValue}>{gps}</Text>
                  </View>
                </View>
              )}

              {!suggestion.data && !suggestion.texte && mediaFiles.images.length === 0 && mediaFiles.audios.length === 0 && !gps && (
                <View style={styles.noDataContainer}>
                  <SafeIcon name="info" size={40} color={modernColors.textSecondary} />
                  <Text style={styles.noDataText}>Aucune donnée à analyser</Text>
                </View>
              )}
            </NativeCard>

            {/* Bouton de génération */}
            <NativeButton
              title="✨ Générer le formulaire"
              onPress={genererFormulaire}
              variant="primary"
              size="large"
              style={styles.generateButton}
            />
          </View>
        )}

        {activeStep === 2 && (
          <View style={styles.stepContainer}>
            {/* Navigation par blocs */}
            {blocks.length > 0 && (
              <>
                {/* Indicateur de progression */}
                <View style={styles.progressContainer}>
                  <View style={styles.progressBar}>
                    <View
                      style={[
                        styles.progressFill,
                        { width: `${((currentBlock + 1) / blocks.length) * 100}%` }
                      ]}
                    />
                  </View>
                  <Text style={styles.progressText}>
                    {currentBlock + 1} / {blocks.length}
                  </Text>
                </View>

                {/* Navigation entre blocs */}
                <View style={styles.blockNavigation}>
                  {blocks.map((block, index) => (
                    <TouchableOpacity
                      key={block.id}
                      style={[
                        styles.blockTab,
                        currentBlock === index && styles.blockTabActive
                      ]}
                      onPress={() => goToBlock(index)}
                    >
                      <Text style={styles.blockTabIcon}>{block.icon}</Text>
                      <Text style={[
                        styles.blockTabText,
                        currentBlock === index && styles.blockTabTextActive
                      ]}>
                        {block.title}
                      </Text>
                    </TouchableOpacity>
                  ))}
                </View>

                {/* Affichage du bloc actuel uniquement */}
                {blocks[currentBlock] && (
                  <View style={styles.sectionContainer}>
                    <LinearGradient
                      colors={['#3B82F6', '#1D4ED8']}
                      start={{ x: 0, y: 0 }}
                      end={{ x: 1, y: 0 }}
                      style={styles.sectionHeader}
                    >
                      <Text style={styles.sectionHeaderText}>
                        {blocks[currentBlock].icon} {blocks[currentBlock].title}
                      </Text>
                    </LinearGradient>

                    <NativeCard style={styles.sectionContent}>
                      {blocks[currentBlock].fields.map((field, index) => renderField(field))}
                    </NativeCard>
                  </View>
                )}

                {/* Boutons de navigation */}
                <View style={styles.navigationButtons}>
                  <TouchableOpacity
                    style={[
                      styles.navButton,
                      styles.navButtonSecondary,
                      currentBlock === 0 && styles.navButtonDisabled
                    ]}
                    onPress={goToPreviousBlock}
                    disabled={currentBlock === 0}
                  >
                    <SafeIcon name="chevron-left" size={20} color="#6B7280" />
                    <Text style={styles.navButtonTextSecondary}>Précédent</Text>
                  </TouchableOpacity>

                  {currentBlock < blocks.length - 1 ? (
                    <TouchableOpacity
                      style={[styles.navButton, styles.navButtonPrimary]}
                      onPress={goToNextBlock}
                    >
                      <Text style={styles.navButtonTextPrimary}>Suivant</Text>
                      <SafeIcon name="chevron-right" size={20} color="#FFFFFF" />
                    </TouchableOpacity>
                  ) : (
                    <TouchableOpacity
                      style={[styles.navButton, styles.navButtonSuccess]}
                      onPress={soumettreFormulaire}
                      disabled={loading}
                    >
                      <Text style={styles.navButtonTextSuccess}>
                        {loading ? 'Création...' : 'Créer le service'}
                      </Text>
                      <SafeIcon name="check" size={20} color="#FFFFFF" />
                    </TouchableOpacity>
                  )}
                </View>
              </>
            )}

              <NativeCard style={styles.sectionContent}>
                <View style={styles.gpsSection}>
                  <View style={styles.gpsHeader}>
                    <SafeIcon name="target" size={16} color={modernColors.error} />
                    <Text style={styles.gpsLabel}>Position GPS fixe (optionnel)</Text>
                  </View>

                  <TouchableOpacity
                    style={styles.gpsSelectButton}
                    onPress={() => setShowGPSModal(true)}
                    activeOpacity={0.8}
                  >
                    <SafeIcon name="map-pin" size={16} color={modernColors.textSecondary} />
                    <Text style={styles.gpsSelectText}>Modifier la position</Text>
                    <SafeIcon name="chevron-down" size={16} color={modernColors.textSecondary} />
                  </TouchableOpacity>

                  {selectedLocation && (
                    <View style={styles.gpsStatus}>
                      <View style={styles.gpsStatusItem}>
                        <SafeIcon name="check" size={16} color={modernColors.success} />
                        <Text style={styles.gpsStatusText}>Position GPS enregistrée:</Text>
                      </View>
                      <View style={styles.gpsStatusItem}>
                        <SafeIcon name="map-pin" size={16} color={modernColors.error} />
                        <Text style={styles.gpsStatusText}>Modifiées dans le formulaire</Text>
                      </View>
                    </View>
                  )}

                  <View style={styles.gpsTip}>
                    <SafeIcon name="lightbulb" size={16} color="#F59E0B" />
                    <Text style={styles.gpsTipText}>
                      Renseignez ce champ si votre service est basé dans un lieu fixe (boutique, bureau, atelier).
                      Cela aide les clients à vous localiser plus facilement.
                    </Text>
                  </View>
                </View>
              </NativeCard>
            </View>

            {/* Section Produits - Style Frontend */}
            <View style={styles.sectionContainer}>
              <LinearGradient
                colors={['#8B5CF6', '#7C3AED']}
                start={{ x: 0, y: 0 }}
                end={{ x: 1, y: 0 }}
                style={styles.sectionHeader}
              >
                <SafeIcon name="shopping-bag" size={16} color="#FFFFFF" />
                <Text style={styles.sectionHeaderText}>🛍️ Produits</Text>
              </LinearGradient>

              <NativeCard style={styles.sectionContent}>
                <View style={styles.productsSection}>
                  <View style={styles.productsHeader}>
                    <SafeIcon name="shopping-bag" size={16} color={modernColors.success} />
                    <Text style={styles.productsLabel}>Produits</Text>
                  </View>

                  <View style={styles.productsInputContainer}>
                    <NativeInput
                      placeholder="Nom du produit"
                      value=""
                      onChangeText={() => { }}
                      style={styles.productsInput}
                    />
                  </View>

                  <View style={styles.productsDropZone}>
                    <SafeIcon name="plus" size={32} color={modernColors.textSecondary} />
                  </View>

                  <Text style={styles.productsDescription}>
                    Gérez les produits de votre service
                  </Text>
                </View>
              </NativeCard>
            </View>

            {/* Section Médias du service - Style Frontend */}
            <View style={styles.sectionContainer}>
              <LinearGradient
                colors={['#F97316', '#EA580C']}
                start={{ x: 0, y: 0 }}
                end={{ x: 1, y: 0 }}
                style={styles.sectionHeader}
              >
                <SafeIcon name="folder" size={16} color="#FFFFFF" />
                <Text style={styles.sectionHeaderText}>📁 Médias du service</Text>
              </LinearGradient>

              <NativeCard style={styles.sectionContent}>
                <View style={styles.mediaSection}>
                  <View style={styles.mediaTabs}>
                    <View style={[styles.mediaTab, styles.mediaTabActive]}>
                      <SafeIcon name="folder" size={16} color="#FFFFFF" />
                      <Text style={styles.mediaTabTextActive}>Général</Text>
                    </View>
                    <View style={styles.mediaTab}>
                      <SafeIcon name="lightbulb" size={16} color={modernColors.textSecondary} />
                      <Text style={styles.mediaTabText}>Identité visuelle</Text>
                    </View>
                  </View>

                  <View style={styles.mediaDropZone}>
                    <SafeIcon name="upload" size={32} color={modernColors.textSecondary} />
                    <Text style={styles.mediaDropText}>
                      Glissez-déposez vos fichiers ici ou cliquez pour sélectionner
                    </Text>
                    <Text style={styles.mediaDropTypes}>
                      Images, vidéos, audios, documents, Excel
                    </Text>
                    <TouchableOpacity style={styles.mediaSelectButton}>
                      <Text style={styles.mediaSelectButtonText}>Sélectionner des fichiers</Text>
                    </TouchableOpacity>
                  </View>

                  <View style={styles.mediaTip}>
                    <SafeIcon name="lightbulb" size={16} color="#F59E0B" />
                    <Text style={styles.mediaTipText}>
                      Conseil : Ajoutez des images de qualité pour attirer plus de clients.
                      Un logo professionnel et une bannière attractive peuvent considérablement
                      améliorer la présentation de votre service.
                    </Text>
                  </View>
                </View>
              </NativeCard>
            </View>

            {/* Section Promotion et Offres - Style Frontend */}
            <View style={styles.sectionContainer}>
              <LinearGradient
                colors={['#EF4444', '#DC2626']}
                start={{ x: 0, y: 0 }}
                end={{ x: 1, y: 0 }}
                style={styles.sectionHeader}
              >
                <SafeIcon name="gift" size={16} color="#FFFFFF" />
                <Text style={styles.sectionHeaderText}>🎉 Promotion et Offres</Text>
              </LinearGradient>

              <NativeCard style={styles.sectionContent}>
                <View style={styles.promotionSection}>
                  <View style={styles.promotionCheckbox}>
                    <TouchableOpacity
                      style={styles.checkbox}
                      onPress={() => setShowPromotionForm(!showPromotionForm)}
                    >
                      {showPromotionForm && (
                        <SafeIcon name="check" size={16} color="#FFFFFF" />
                      )}
                    </TouchableOpacity>
                    <Text style={styles.promotionCheckboxText}>
                      Activer une promotion pour ce service
                    </Text>
                  </View>

                  {showPromotionForm && (
                    <View style={styles.promotionForm}>
                      <View style={styles.promotionField}>
                        <View style={styles.promotionFieldHeader}>
                          <SafeIcon name="tag" size={16} color="#8B4513" />
                          <Text style={styles.promotionFieldLabel}>Type de promotion</Text>
                        </View>
                        <View style={styles.promotionSelect}>
                          <Text style={styles.promotionSelectText}>Réduction</Text>
                          <SafeIcon name="chevron-down" size={16} color={modernColors.textSecondary} />
                        </View>
                      </View>

                      <View style={styles.promotionField}>
                        <View style={styles.promotionFieldHeader}>
                          <SafeIcon name="dollar-sign" size={16} color="#F59E0B" />
                          <Text style={styles.promotionFieldLabel}>Valeur de la promotion</Text>
                        </View>
                        <NativeInput
                          placeholder="ex: 20%, 50€, Gratuit"
                          value=""
                          onChangeText={() => { }}
                          style={styles.promotionInput}
                        />
                      </View>

                      <View style={styles.promotionField}>
                        <View style={styles.promotionFieldHeader}>
                          <SafeIcon name="file-text" size={16} color={modernColors.textSecondary} />
                          <Text style={styles.promotionFieldLabel}>Description de la promotion</Text>
                        </View>
                        <NativeInput
                          placeholder="Décrivez votre offre promotionnelle..."
                          value=""
                          onChangeText={() => { }}
                          multiline
                          style={styles.promotionTextarea}
                        />
                      </View>

                      <View style={styles.promotionField}>
                        <View style={styles.promotionFieldHeader}>
                          <SafeIcon name="calendar" size={16} color={modernColors.error} />
                          <Text style={styles.promotionFieldLabel}>Date de fin de promotion</Text>
                        </View>
                        <NativeInput
                          placeholder="jj/mm/aaaa"
                          value=""
                          onChangeText={() => { }}
                          style={styles.promotionInput}
                        />
                      </View>

                      <View style={styles.promotionField}>
                        <View style={styles.promotionFieldHeader}>
                          <SafeIcon name="alert-triangle" size={16} color="#F59E0B" />
                          <Text style={styles.promotionFieldLabel}>Conditions (optionnel)</Text>
                        </View>
                        <NativeInput
                          placeholder="Conditions spéciales, limitations..."
                          value=""
                          onChangeText={() => { }}
                          multiline
                          style={styles.promotionTextarea}
                        />
                      </View>
                    </View>
                  )}

                  <View style={styles.promotionTip}>
                    <SafeIcon name="lightbulb" size={16} color="#F59E0B" />
                    <Text style={styles.promotionTipText}>
                      Conseil : Les promotions attirent l'attention et peuvent augmenter
                      significativement vos ventes.
                    </Text>
                  </View>
                </View>
              </NativeCard>
            </View>

            {/* Boutons d'action */}
            <View style={styles.buttonContainer}>
              <NativeButton
                title="← Retour"
                onPress={() => setActiveStep(1)}
                variant="outline"
                size="medium"
                style={styles.backButtonForm}
              />

              <NativeButton
                title={mode === 'edit' ? '✓ Mettre à jour' : '✓ Créer le service'}
                onPress={soumettreFormulaire}
                disabled={loading}
                variant="primary"
                size="medium"
                style={styles.submitButton}
              />
            </View>
          </View>
        )}
      </ScrollView>

      {/* Toast de succès moderne */}
      {showSuccessToast && successData && (
        <View style={styles.successOverlay}>
          <View style={styles.successModal}>
            <LinearGradient
              colors={modernColors.successGradient}
              style={styles.successGradient}
            >
              <SafeIcon name="check" size={60} color="#fff" />
            </LinearGradient>
            <Text style={styles.successTitle}>Service créé avec succès !</Text>
            <Text style={styles.successText}>
              Coût: {successData.cout} tokens
            </Text>
            <Text style={styles.successSubtext}>
              Redirection vers le service...
            </Text>
          </View>
        </View>
      )}

      {/* Modal GPS Amélioré */}
      <EnhancedGPSModal
        visible={showGPSModal}
        onClose={() => setShowGPSModal(false)}
        onSelect={(coordinates) => {
          setSelectedLocation({ lat: coordinates.lat, lng: coordinates.lng });
          setValeursFormulaire(prev => ({
            ...prev,
            gps_fixe: `${coordinates.lat},${coordinates.lng}`
          }));
          setShowGPSModal(false);
        }}
        currentLocation={selectedLocation}
        title="Sélection de localisation GPS"
      />
    </View>
  );
};

