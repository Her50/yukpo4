{
  "name": "yukpo-video-renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "render:exec": "node ./dist/src/cli/render-worker.js",
    "render": "npm run build && npm run render:exec",
    "render:sample": "npm run build && npm run render:exec -- --job ./samples/sample-job.json --overwrite",
    "start": "node ./dist/src/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.609.0",
    "@aws-sdk/lib-storage": "^3.609.0",
    "@remotion/bundler": "^4.0.88",
    "@react-three/drei": "^9.110.0",
    "@react-three/fiber": "^8.15.12",
    "@remotion/lottie": "^4.0.88",
    "@remotion/renderer": "^4.0.88",
    "@remotion/three": "^4.0.88",
    "ffmpeg-static": "^5.2.0",
    "express": "^4.19.2",
    "fs-extra": "^11.2.0",
    "globby": "^14.0.2",
    "picocolors": "^1.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "three": "^0.164.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/glob": "^8.1.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.30",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.167.2",
    "typescript": "^5.6.3"
  }
}