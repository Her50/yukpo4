# .gcloudignore — Cloud Build upload filter
# Files are INCLUDED by default; only list what to EXCLUDE

# Artefacts Rust (très lourds — jusqu'à 6 GB)
backend/target/

# Mobile et frontend (tout sauf le code source backend)
mobile/
mobile-apps/
node_modules/
frontend/
web-app/
.expo/
dist-bourse/
dist-pharmacie/
dist-restaurant/
dist-lite/
dist/
deploy-*.zip

# Git et IDE
.git/
.gitignore
.gitattributes
.vscode/
.idea/
.claude/

# CI/CD inutile
.github/
.travis.yml
.circleci/
docker-compose*.yml

# Fichiers volumineux non nécessaires au build
*.pptx
*.pdf
*.backup
*.bak
*.zip

# Logs et temporaires
*.log
*.tmp
logs/
tmp/
temp/
scripts/__pycache__/

# Docs
docs/
deployment/

# Fichiers de l'éditeur
*.swp
*.swo
*~
.DS_Store
