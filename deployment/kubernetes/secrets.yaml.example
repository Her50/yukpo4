# ✅ Phase 2: Secrets Kubernetes (exemple - à remplir avec vos valeurs)

apiVersion: v1
kind: Secret
metadata:
  name: yukpomnang-secrets
  namespace: yukpomnang
type: Opaque
stringData:
  # ✅ Database
  DATABASE_URL: "postgresql://user:password@host:5432/dbname"
  
  # ✅ Redis
  REDIS_URL: "redis://redis-host:6379"
  REDIS_PASSWORD: "your-redis-password"
  REDIS_NODES: "redis-node1:6379,redis-node2:6379,redis-node3:6379"
  
  # ✅ JWT
  JWT_SECRET: "your-jwt-secret-key"
  
  # ✅ AWS S3 (si utilisé)
  AWS_ACCESS_KEY_ID: "your-aws-access-key"
  AWS_SECRET_ACCESS_KEY: "your-aws-secret-key"
  AWS_REGION: "us-east-1"

---
# ✅ Instructions:
# 1. Copier ce fichier vers secrets.yaml (ne pas commiter!)
# 2. Remplir avec vos valeurs réelles
# 3. Appliquer: kubectl apply -f deployment/kubernetes/secrets.yaml
# 4. Vérifier: kubectl get secrets -n yukpomnang

