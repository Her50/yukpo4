DATABASE_URL=postgres://user:pass@host/yukpo_staging
REDIS_URL=redis://host:6379/
MONGODB_URL=mongodb://host:27017

# Vidéo immersive
VIDEO_RENDERER_PROJECT_ROOT=video-renderer
VIDEO_RENDERER_ENABLED=true
VIDEO_RENDERER_AUTO_BUILD=false
VIDEO_RENDERER_ENABLE_GPU=false

# Audio premium
PREMIUM_AUDIO_ENABLED=false
PREMIUM_AUDIO_PROVIDER=dolby

# B-roll IA / stockage
STOCK_VIDEO_API_URL=
STOCK_VIDEO_API_KEY=
AWS_WASABI_ENDPOINT=
AWS_WASABI_ACCESS_KEY_ID=
AWS_WASABI_SECRET_ACCESS_KEY=

# Feature flags backend
FEATURE_FLAG_GPU_WORKER=true
FEATURE_FLAG_CONNECTORS_LIVEKIT=false
FEATURE_FLAG_DELIVERY_V2=true
FEATURE_FLAG_GLOBAL_PROMOS=true

# Commission Yukpo pour livraisons (Phase 5)
# Valeur par défaut: 0.05 = 5%
# Exemple: YUKPO_COMMISSION_RATE=0.10 pour 10%
YUKPO_COMMISSION_RATE=0.05

# Notifications SMS/Email (Phase 6 - Amélioration 19)
SMS_ENABLED=false
SMS_PROVIDER=twilio  # twilio, orange
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

EMAIL_ENABLED=false
EMAIL_PROVIDER=sendgrid  # sendgrid, ses
SENDGRID_API_KEY=
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=



