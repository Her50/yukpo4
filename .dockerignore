# 🚀 .dockerignore for root context build
# Exclut les fichiers inutiles pour réduire la taille du contexte Docker

############################################
# Build artifacts et dépendances
############################################
target/
*.pdb
*.dSYM

############################################
# Fichiers de développement
############################################
.env
.env.local
.env.*.local
*.swp
*.swo
*~
.DS_Store
Thumbs.db

############################################
# IDE et éditeurs
############################################
.vscode/
.idea/
*.code-workspace
*.sublime-*

############################################
# Logs et fichiers temporaires
############################################
*.log
*.tmp
logs/
tmp/
temp/
*.backup
*.bak

############################################
# Documentation (sauf README)
############################################
*.md
!README.md
docs/
*.txt

############################################
# Tests et coverage
############################################
tests/
test/
*.test.rs
coverage/
.nyc_output/

############################################
# Git et versioning
############################################
.git/
.gitignore
.gitattributes
.gitmodules

############################################
# CI/CD (non nécessaires dans l'image)
############################################
.github/
.gitlab-ci.yml
.travis.yml
.circleci/

############################################
# Docker files (éviter la récursion)
############################################
.dockerignore
docker-compose*.yml

############################################
# Fichiers système
############################################
*.orig
*.rej
*.patch

############################################
# INCLUSIONS IMPORTANTES (backend)
############################################
# ✅ Backend - SQLx cache
!backend/.sqlx/
!backend/.sqlx/**/*

# ✅ Backend - Code source
!backend/src/
!backend/src/**/*

# ✅ Backend - Configuration
!backend/config/
!backend/config/**/*

# ✅ Backend - Migrations
!backend/migrations/
!backend/migrations/**/*

# ✅ Backend - Prompts IA
!backend/ia_prompts/
!backend/ia_prompts/**/*

# ✅ Backend - Fichiers de configuration Rust
!backend/Cargo.toml
!backend/Cargo.lock

# ✅ Backend - Blender
!backend/blender/
!backend/blender/**/*

# ✅ Backend - Public files (test-download.html, .well-known, etc.)
!backend/public/
!backend/public/**/*

# ✅ Backend - Scripts
!backend/scripts/
!backend/scripts/**/*

# ✅ Backend - Autres fichiers nécessaires
!backend/ia_intentions_instructions.md
