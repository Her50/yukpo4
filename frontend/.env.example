# =====================================================================
# Frontend Yukpo — Template de variables d'environnement
# Copier ce fichier en `.env` (dev) ou `.env.production` (build prod).
# AUCUNE VRAIE CLÉ NE DOIT ÊTRE COMMITÉE DANS CE REPO PUBLIC.
# Pour la prod : configurer dans Netlify → Site settings → Env variables.
# =====================================================================

# --- API backend ---
# Vide en prod Netlify (le proxy netlify.toml gère le rewrite)
# En dev : URL complète, ex: http://localhost:8001
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# URL du service d'embedding (peut rester vide si non utilisé)
VITE_APP_EMBEDDING_URL=

# --- Environnement ---
VITE_APP_ENV=production
VITE_APP_DEBUG=false
VITE_APP_TITLE=Yukpo - Services Intelligents
VITE_APP_DESCRIPTION=Plateforme de services intelligents avec IA

# --- Clés API tierces (À RENSEIGNER COTÉ HOST, JAMAIS ICI) ---
# Google Maps JavaScript API — restreindre par domaine (yukpomnang.com)
VITE_APP_GOOGLE_MAPS_API_KEY=

# Pinecone (vector search) — clé `pcsk_...`
# ⚠️ Idéalement appelé via proxy backend, pas exposé en clair côté browser
VITE_APP_PINECONE_API_KEY=

# OpenAI (proxy de préférence via backend)
VITE_APP_AI_SERVICE_URL=https://api.openai.com/v1

# Clé interne front→backend (durcir, rotater régulièrement)
VITE_APP_YUKPO_API_KEY=

# --- Performance & Optimization ---
VITE_APP_MAX_RETRIES=3
VITE_APP_TIMEOUT=30000
VITE_APP_CACHE_ENABLED=true
VITE_APP_LAZY_LOADING=true
VITE_APP_COMPRESSION=true

# --- Production hardening ---
VITE_APP_HOT_RELOAD=false
VITE_APP_SOURCE_MAPS=false
VITE_APP_DEVTOOLS=false

# --- Security ---
VITE_APP_CSP_ENABLED=true
VITE_APP_HTTPS_ONLY=true

# --- URL publique du site (utilisée pour les liens canoniques) ---
VITE_PUBLIC_URL=https://bourse.yukpomnang.com
