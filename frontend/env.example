# 🌍 Configuration des services de traduction et géolocalisation

# Google Translate API Key (obligatoire pour la traduction automatique)
VITE_GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# API Base URL (optionnel, utilise l'URL par défaut si non défini)
VITE_API_BASE_URL=https://yukpomnang.onrender.com

# Configuration de développement
VITE_DEV_MODE=false
VITE_DEBUG_TRANSLATION=false

# Configuration des services de géocodage (optionnel)
VITE_GEOCODING_API_KEY=your_geocoding_api_key_here
VITE_GEOCODING_PROVIDER=google

# Configuration des notifications push (optionnel)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Configuration WebSocket (optionnel)
VITE_WS_URL=wss://yukpomnang.onrender.com/ws

