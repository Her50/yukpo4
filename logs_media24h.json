    "textPayload": "\u001b[2m2026-02-25T05:42:50.443582Z\u001b[0m \u001b[33m WARN\u001b[0m \u001b[2msqlx::query\u001b[0m\u001b[2m:\u001b[0m slow statement: execution time exceeded alert threshold \u001b[3msummary\u001b[0m\u001b[2m=\u001b[0m\"SELECT t.relname::text as tablename, ?\" \u001b[3mdb.statement\u001b[0m\u001b[2m=\u001b[0m\"\\n\\n\\n            SELECT \\n                t.relname::text as tablename,\\n                c.relname::text as indexname,\\n                COALESCE(i.indisunique, false) as indisunique\\n            FROM pg_index i\\n            JOIN pg_class c ON c.oid = i.indexrelid\\n            JOIN pg_class t ON t.oid = i.indrelid\\n            JOIN pg_namespace n ON n.oid = t.relnamespace\\n            WHERE n.nspname = 'public'\\n              AND t.relname IN ('services', 'pharmacies', 'hopitaux_cliniques', 'laboratoires_imagerie', 'agences_voyage', 'covoiturages', 'taxis_ville')\\n            \\n\" \u001b[3mrows_affected\u001b[0m\u001b[2m=\u001b[0m193 \u001b[3mrows_returned\u001b[0m\u001b[2m=\u001b[0m193 \u001b[3melapsed\u001b[0m\u001b[2m=\u001b[0m1.099962478s \u001b[3melapsed_secs\u001b[0m\u001b[2m=\u001b[0m1.099962478 \u001b[3mslow_threshold\u001b[0m\u001b[2m=\u001b[0m1s",
