# Configuration API
EXPO_PUBLIC_API_URL=http://localhost:3001/api
EXPO_PUBLIC_API_URL_PRODUCTION=https://your-production-api.com/api

# Google Maps
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Configuration de l'application
EXPO_PUBLIC_APP_NAME=Yukpomnang
EXPO_PUBLIC_APP_VERSION=1.0.0

# Configuration de l'environnement
EXPO_PUBLIC_ENVIRONMENT=development

# Configuration des notifications
EXPO_PUBLIC_FCM_SERVER_KEY=your_fcm_server_key

# Configuration des paiements (optionnel)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Configuration des analytics (optionnel)
EXPO_PUBLIC_ANALYTICS_ID=your_analytics_id

