# Configuration Tests - Yukpomnang Mobile
# Copiez ce fichier vers .env et configurez selon votre environnement de test

# Configuration API Backend (OBLIGATOIRE)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api
EXPO_PUBLIC_API_TIMEOUT=5000

# Configuration de l'application (OBLIGATOIRE)
EXPO_PUBLIC_APP_NAME=Yukpomnang Test
EXPO_PUBLIC_APP_VERSION=1.0.0-test

# Configuration des services externes (OPTIONNEL)
# Google Maps API Key (pour la géolocalisation)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=test_google_maps_api_key

# Mapbox Access Token (alternative à Google Maps)
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=test_mapbox_token

# Configuration de test (OBLIGATOIRE)
EXPO_PUBLIC_DEBUG_MODE=true
EXPO_PUBLIC_LOG_LEVEL=debug

# Configuration des analytics (OPTIONNEL)
EXPO_PUBLIC_ANALYTICS_ENABLED=false
EXPO_PUBLIC_CRASH_REPORTING_ENABLED=false

# Configuration des notifications push (OPTIONNEL)
EXPO_PUBLIC_PUSH_NOTIFICATIONS_ENABLED=false

# Configuration de la géolocalisation (OPTIONNEL)
EXPO_PUBLIC_LOCATION_ACCURACY=low
EXPO_PUBLIC_LOCATION_TIMEOUT=2000

# Configuration du cache (OPTIONNEL)
EXPO_PUBLIC_CACHE_ENABLED=false
EXPO_PUBLIC_CACHE_DURATION=1000

# Configuration des mocks (OPTIONNEL)
EXPO_PUBLIC_USE_MOCKS=true
EXPO_PUBLIC_MOCK_DELAY=500

# Configuration des tests (OPTIONNEL)
EXPO_PUBLIC_TEST_MODE=true
EXPO_PUBLIC_TEST_USER_ID=test_user_123
EXPO_PUBLIC_TEST_SERVICE_ID=test_service_456
EXPO_PUBLIC_TEST_CHAT_ID=test_chat_789

# Configuration des données de test (OPTIONNEL)
EXPO_PUBLIC_TEST_LOCATION_LAT=48.8566
EXPO_PUBLIC_TEST_LOCATION_LNG=2.3522
EXPO_PUBLIC_TEST_LOCATION_ADDRESS=Paris, France

