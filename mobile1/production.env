# Configuration Production - Yukpomnang Mobile
# Copiez ce fichier vers .env et configurez selon votre environnement

# Configuration API Backend (OBLIGATOIRE)
EXPO_PUBLIC_API_BASE_URL=https://api.yukpomnang.com
EXPO_PUBLIC_API_TIMEOUT=15000

# Configuration de l'application (OBLIGATOIRE)
EXPO_PUBLIC_APP_NAME=Yukpomnang
EXPO_PUBLIC_APP_VERSION=1.0.0

# Configuration des services externes (OPTIONNEL)
# Google Maps API Key (pour la géolocalisation)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_production_google_maps_api_key_here

# Mapbox Access Token (alternative à Google Maps)
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=your_production_mapbox_token_here

# Configuration de production (OBLIGATOIRE)
EXPO_PUBLIC_DEBUG_MODE=false
EXPO_PUBLIC_LOG_LEVEL=error

# Configuration des analytics (OPTIONNEL)
EXPO_PUBLIC_ANALYTICS_ENABLED=true
EXPO_PUBLIC_CRASH_REPORTING_ENABLED=true

# Configuration des notifications push (OPTIONNEL)
EXPO_PUBLIC_PUSH_NOTIFICATIONS_ENABLED=true

# Configuration de la géolocalisation (OPTIONNEL)
EXPO_PUBLIC_LOCATION_ACCURACY=high
EXPO_PUBLIC_LOCATION_TIMEOUT=10000

# Configuration du cache (OPTIONNEL)
EXPO_PUBLIC_CACHE_ENABLED=true
EXPO_PUBLIC_CACHE_DURATION=3600000

