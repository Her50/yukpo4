# 🚀 Dockerfile.cloud AVEC BLENDER - Version complète pour rendu 3D
# Taille: ~1.5-2GB (optimisé par rapport à la version actuelle)
# Utilise une image de base plus légère et optimise Blender

############################################
# Stage 1: Builder - Compilation Rust optimisée
############################################
FROM rust:1.75-slim AS builder

WORKDIR /app

ENV SQLX_OFFLINE=true
ENV RUSTFLAGS="-C link-arg=-fuse-ld=lld -C target-cpu=native"
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true

# Installer uniquement les dépendances essentielles
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    libpq-dev \
    libclang-dev \
    clang \
    lld \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Cache des dépendances Rust
COPY Cargo.toml Cargo.lock ./
COPY .sqlx ./.sqlx

RUN mkdir -p src && \
    echo "fn main() {}" > src/main.rs && \
    cargo build --release --features gpu 2>&1 | head -20 || true && \
    rm -rf src && \
    rm -rf /root/.cargo/registry/cache

# Code source
COPY src ./src
COPY scripts ./scripts
COPY ia_prompts ./ia_prompts
COPY config ./config
COPY migrations ./migrations
COPY ia_intentions_instructions.md ./

RUN cargo build --release --features gpu \
    && strip target/release/yukpomnang_backend \
    && rm -rf /root/.cargo/registry/cache \
    && rm -rf /root/.cargo/git

############################################
# Stage 2: Blender Downloader (séparé pour cache)
############################################
FROM debian:bookworm-slim AS blender-downloader

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Télécharger Blender (cette couche est mise en cache si Blender ne change pas)
RUN wget --tries=3 --timeout=300 --progress=dot:giga \
    https://download.blender.org/release/Blender4.0/blender-4.0.0-linux-x64.tar.xz -O /tmp/blender.tar.xz \
    && tar -xf /tmp/blender.tar.xz -C /tmp \
    && mv /tmp/blender-4.0.0-linux-x64 /opt/blender \
    && rm /tmp/blender.tar.xz

############################################
# Stage 3: Runtime - Image finale avec Blender
############################################
FROM debian:bookworm-slim

LABEL maintainer="Yukpomnang Team"
LABEL description="Yukpomnang Backend Cloud avec Blender - Optimisé"

# Installer uniquement les dépendances runtime minimales pour Blender
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libpq5 \
    libssl3 \
    curl \
    xvfb \
    libx11-6 \
    libxrender1 \
    libxi6 \
    libgl1-mesa-glx \
    libglu1-mesa \
    libxkbcommon0 \
    libsm6 \
    libice6 \
    libfontconfig1 \
    libxext6 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copier Blender depuis le stage dédié
COPY --from=blender-downloader /opt/blender /opt/blender
RUN ln -sf /opt/blender/blender /usr/local/bin/blender

# Créer utilisateur non-root
RUN groupadd -r appuser -g 1000 && \
    useradd -r -g appuser -u 1000 -m -d /home/appuser -s /bin/bash appuser

# Créer les répertoires
# ✅ IMPORTANT: l'app utilise UPLOAD_STORAGE_PATH par défaut = /var/data/uploads
RUN mkdir -p /app/config /app/logs /app/data /app/uploads /app/migrations /app/ia_prompts /var/data/uploads \
    && chown -R appuser:appuser /app /var/data

# Copier l'exécutable depuis le builder
COPY --from=builder --chown=appuser:appuser /app/target/release/yukpomnang_backend /app/yukpomnang_backend

# Copier les fichiers de configuration
COPY --from=builder --chown=appuser:appuser /app/config /app/config
COPY --from=builder --chown=appuser:appuser /app/migrations /app/migrations
COPY --from=builder --chown=appuser:appuser /app/ia_prompts /app/ia_prompts
COPY --from=builder --chown=appuser:appuser /app/ia_intentions_instructions.md /app/

# Script de démarrage
COPY scripts/start-cloud.sh /app/start-cloud.sh
RUN chmod +x /app/start-cloud.sh

# Variables d'environnement
ENV RUST_LOG=info
ENV RUST_BACKTRACE=1
ENV APP_ENV=production
ENV PORT=8080
ENV HOST=0.0.0.0

EXPOSE 8080
WORKDIR /app
USER appuser

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["/app/start-cloud.sh"]
CMD ["./yukpomnang_backend"]

