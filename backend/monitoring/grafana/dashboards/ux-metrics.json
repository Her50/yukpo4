{
    "dashboard": {
        "title": "Métriques UX - Yukpomnang",
        "tags": [
            "ux",
            "metrics",
            "yukpomnang"
        ],
        "timezone": "browser",
        "schemaVersion": 16,
        "version": 1,
        "refresh": "30s",
        "panels": [
            {
                "id": 1,
                "title": "Scrolls Carrousels Produits",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 0
                },
                "targets": [
                    {
                        "expr": "rate(product_carousel_scrolls_total[5m])",
                        "legendFormat": "Scrolls/min",
                        "refId": "A"
                    }
                ],
                "yaxes": [
                    {
                        "format": "short",
                        "label": "Scrolls/min"
                    },
                    {
                        "format": "short"
                    }
                ]
            },
            {
                "id": 2,
                "title": "Scrolls Carrousels Vidéos",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 0
                },
                "targets": [
                    {
                        "expr": "rate(video_carousel_scrolls_total[5m])",
                        "legendFormat": "Scrolls/min",
                        "refId": "A"
                    }
                ],
                "yaxes": [
                    {
                        "format": "short",
                        "label": "Scrolls/min"
                    },
                    {
                        "format": "short"
                    }
                ]
            },
            {
                "id": 3,
                "title": "Recherches ResultatBesoinScreen",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 8
                },
                "targets": [
                    {
                        "expr": "rate(resulta_besoin_screen_searches_total[5m])",
                        "legendFormat": "Recherches/min",
                        "refId": "A"
                    },
                    {
                        "expr": "rate(resulta_besoin_screen_searches_without_results_total[5m])",
                        "legendFormat": "Sans résultats/min",
                        "refId": "B"
                    }
                ],
                "yaxes": [
                    {
                        "format": "short",
                        "label": "Recherches/min"
                    },
                    {
                        "format": "short"
                    }
                ]
            },
            {
                "id": 4,
                "title": "Clics sur Produits",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 8
                },
                "targets": [
                    {
                        "expr": "rate(resulta_besoin_screen_item_clicks_total[5m])",
                        "legendFormat": "Clics/min",
                        "refId": "A"
                    }
                ],
                "yaxes": [
                    {
                        "format": "short",
                        "label": "Clics/min"
                    },
                    {
                        "format": "short"
                    }
                ]
            },
            {
                "id": 5,
                "title": "Messages Chat Envoyés",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 16
                },
                "targets": [
                    {
                        "expr": "rate(chat_messages_sent_total[5m])",
                        "legendFormat": "Messages/min",
                        "refId": "A"
                    }
                ],
                "yaxes": [
                    {
                        "format": "short",
                        "label": "Messages/min"
                    },
                    {
                        "format": "short"
                    }
                ]
            },
            {
                "id": 6,
                "title": "Conversations Actives",
                "type": "stat",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 16
                },
                "targets": [
                    {
                        "expr": "chat_conversations_active_total",
                        "refId": "A"
                    }
                ],
                "options": {
                    "colorMode": "value",
                    "graphMode": "area",
                    "justifyMode": "auto",
                    "orientation": "auto",
                    "reduceOptions": {
                        "values": false,
                        "calcs": [
                            "lastNotNull"
                        ],
                        "fields": ""
                    },
                    "textMode": "auto"
                }
            },
            {
                "id": 7,
                "title": "Vues Vidéos",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 24
                },
                "targets": [
                    {
                        "expr": "rate(video_carousel_videos_viewed_total[5m])",
                        "legendFormat": "Vues/min",
                        "refId": "A"
                    }
                ],
                "yaxes": [
                    {
                        "format": "short",
                        "label": "Vues/min"
                    },
                    {
                        "format": "short"
                    }
                ]
            },
            {
                "id": 8,
                "title": "Play/Pause Vidéos",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 24
                },
                "targets": [
                    {
                        "expr": "rate(video_carousel_play_events_total[5m])",
                        "legendFormat": "Play/min",
                        "refId": "A"
                    },
                    {
                        "expr": "rate(video_carousel_pause_events_total[5m])",
                        "legendFormat": "Pause/min",
                        "refId": "B"
                    }
                ],
                "yaxes": [
                    {
                        "format": "short",
                        "label": "Événements/min"
                    },
                    {
                        "format": "short"
                    }
                ]
            }
        ]
    }
}