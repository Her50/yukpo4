# ✅ Phase 3 - Configuration Nginx pour Scaling Horizontal
# Configuration pour plusieurs instances backend

events {
    worker_connections 10000;
    use epoll;
    multi_accept on;
}

http {
    # Optimisations de base
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    client_max_body_size 500M;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/json
        application/javascript
        application/xml+rss
        application/atom+xml
        image/svg+xml;

    # Rate limiting
    limit_req_zone $binary_remote_addr zone=api:10m rate=100r/m;
    limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;

    # ✅ Phase 3: Upstream pour plusieurs instances backend (scaling horizontal)
    upstream app_backend {
        least_conn;  # ✅ Répartition par connexions actives (meilleur pour DB)
        
        # ✅ Instances backend (à configurer selon déploiement)
        # Option 1: Docker Compose avec scale
        server backend-1:3001 max_fails=3 fail_timeout=30s weight=1;
        server backend-2:3001 max_fails=3 fail_timeout=30s weight=1;
        server backend-3:3001 max_fails=3 fail_timeout=30s weight=1;
        
        # Option 2: Kubernetes (utiliser service name)
        # server yukpo-backend-service:3001 max_fails=3 fail_timeout=30s;
        
        # Option 3: IPs directes (production)
        # server 10.0.1.10:3001 max_fails=3 fail_timeout=30s;
        # server 10.0.1.11:3001 max_fails=3 fail_timeout=30s;
        # server 10.0.1.12:3001 max_fails=3 fail_timeout=30s;
        
        keepalive 32;
        
        # ✅ Health check (nécessite nginx-plus ou module tiers)
        # health_check interval=10s fails=3 passes=2;
    }

    # Configuration SSL
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Headers de sécurité
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:;" always;

    # Serveur HTTP (redirection vers HTTPS)
    server {
        listen 80;
        server_name _;
        return 301 https://$host$request_uri;
    }

    # Serveur HTTPS principal
    server {
        listen 443 ssl http2;
        server_name yukpomnang.com www.yukpomnang.com;

        # Certificats SSL
        ssl_certificate /etc/nginx/ssl/cert.pem;
        ssl_certificate_key /etc/nginx/ssl/key.pem;

        # Logs
        access_log /var/log/nginx/access.log combined buffer=512k flush=1m;
        error_log /var/log/nginx/error.log warn;

        # ✅ Health check vers backend (proxy)
        location /api/health {
            proxy_pass http://app_backend;
            access_log off;
            proxy_connect_timeout 2s;
            proxy_read_timeout 5s;
            
            # ✅ Headers pour identifier l'instance backend
            add_header X-Backend-Instance $upstream_addr;
        }
        
        # Health check simple pour Nginx lui-même
        location /health {
            access_log off;
            return 200 "healthy\n";
            add_header Content-Type text/plain;
        }

        # Métriques Prometheus
        location /metrics {
            access_log off;
            proxy_pass http://app_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # API principale avec rate limiting
        location /api/ {
            limit_req zone=api burst=20 nodelay;
            
            proxy_pass http://app_backend;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
            
            # ✅ Headers pour identifier l'instance backend
            add_header X-Backend-Instance $upstream_addr;
            
            # Timeouts
            proxy_connect_timeout 30s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
            
            # Buffer optimisations
            proxy_buffering on;
            proxy_buffer_size 4k;
            proxy_buffers 8 4k;
            proxy_busy_buffers_size 8k;
        }

        # ✅ WebSocket support pour real-time updates (scaling horizontal)
        location /ws/ {
            proxy_pass http://app_backend;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            # ✅ Timeouts longs pour WebSocket
            proxy_connect_timeout 7d;
            proxy_send_timeout 7d;
            proxy_read_timeout 7d;
            
            # ✅ Headers pour identifier l'instance backend
            add_header X-Backend-Instance $upstream_addr;
        }

        # Authentification avec rate limiting strict
        location /api/auth/ {
            limit_req zone=login burst=5 nodelay;
            
            proxy_pass http://app_backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Fichiers statiques avec cache
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
            access_log off;
        }

        # Fallback pour SPA
        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}

