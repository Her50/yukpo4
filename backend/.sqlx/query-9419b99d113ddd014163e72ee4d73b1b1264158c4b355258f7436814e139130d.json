  "db_name": "PostgreSQL",
  "query": "\n            SELECT \n                job_id,\n                user_id,\n                service_id,\n                product_index,\n                'Normal' as priority,\n                result_payload as payload,\n                created_at,\n                0 as retry_count,\n                3 as max_retries\n            FROM video_generation_jobs\n            WHERE status = 'queued'\n            ORDER BY \n                created_at ASC\n            LIMIT $1\n            FOR UPDATE SKIP LOCKED\n            ",
