  "query": "\n        SELECT id, data, created_at, user_id, gps, category, is_active\n        FROM services\n        WHERE is_active = TRUE\n        AND created_at >= NOW() - INTERVAL '30 days'\n        ORDER BY created_at DESC\n        LIMIT $1\n        ",
