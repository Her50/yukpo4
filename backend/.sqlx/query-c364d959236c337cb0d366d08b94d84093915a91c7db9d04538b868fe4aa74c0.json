{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                delivery_id,\n                zone_id,\n                status as \"status: DeliveryMatchingStatus\",\n                priority,\n                attempt_count,\n                payload,\n                next_attempt_at,\n                enqueued_at,\n                updated_at\n            FROM delivery_matching_queue\n            WHERE status IN ('queued', 'searching')\n              AND next_attempt_at <= NOW()\n            ORDER BY priority ASC, next_attempt_at ASC\n            LIMIT $1\n            ",
