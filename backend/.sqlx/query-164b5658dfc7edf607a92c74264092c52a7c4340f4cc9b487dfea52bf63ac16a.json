  "query": "\n        SELECT\n            m.path,\n            m.ai_description,\n            m.ai_tags,\n            m.ai_metadata,\n            s.data                AS \"service_data: serde_json::Value\"\n        FROM media m\n        JOIN services s ON s.id = m.service_id\n        WHERE m.id = $1\n          AND s.id = $2\n        ",
