  "query": "\n            SELECT\n                id,\n                delivery_id,\n                submitted_by AS \"submitted_by?: i32\",\n                latitude,\n                longitude,\n                address      AS \"address?: String\",\n                created_at   AS \"created_at!: chrono::DateTime<Utc>\"\n            FROM delivery_recipient_updates\n            WHERE delivery_id = $1\n            ORDER BY created_at DESC\n            LIMIT $2\n            ",
