{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            pl.id,\n            pl.product_nom as nom,\n            pl.product_type as type,\n            pl.is_active,\n            pl.service_id\n        FROM products_lifecycle pl\n        JOIN services s ON pl.service_id = s.id\n        WHERE s.user_id = $1\n        ORDER BY pl.created_at DESC\n        ",
