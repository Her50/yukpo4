  "query": "\n            SELECT\n                id,\n                requested_at,\n                delivered_at,\n                metadata\n            FROM deliveries\n            WHERE delivered_at IS NOT NULL\n              AND delivered_at >= NOW() - ($1::int * INTERVAL '1 minute')\n            ",
