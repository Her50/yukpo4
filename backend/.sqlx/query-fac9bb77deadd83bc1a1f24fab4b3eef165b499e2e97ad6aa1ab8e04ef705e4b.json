  "query": "\n                INSERT INTO shopping_order_items (\n                    shopping_order_id,\n                    product_id,\n                    product_name,\n                    characteristics,\n                    quantity,\n                    unit,\n                    estimated_price_cents,\n                    actual_price_cents,\n                    status,\n                    metadata\n                )\n                VALUES (\n                    $1,$2,$3,$4,$5,$6,$7,NULL,$8,$9\n                )\n                RETURNING\n                    id,\n                    shopping_order_id,\n                    product_id,\n                    product_name,\n                    characteristics,\n                    quantity,\n                    unit,\n                    estimated_price_cents,\n                    actual_price_cents,\n                    status AS \"status: ShoppingItemStatus\",\n                    metadata,\n                    created_at,\n                    updated_at\n                ",
