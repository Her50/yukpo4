{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                delivery_id,\n                status AS \"status: DeliveryStatus\",\n                occurred_at,\n                COALESCE(payload, '{}'::jsonb) AS \"payload!: serde_json::Value\",\n                recorded_by AS \"recorded_by?: i32\"\n            FROM delivery_status_events\n            WHERE delivery_id = $1\n            ORDER BY occurred_at ASC\n            LIMIT $2\n            ",
