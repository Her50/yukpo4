  "query": "\n            SELECT\n                id,\n                user_id,\n                status AS \"status: DeliveryApplicationStatus\",\n                submitted_at,\n                reviewed_at,\n                reviewer_id,\n                rejection_reason,\n                profile_data,\n                documents,\n                notes,\n                created_at,\n                updated_at\n            FROM courier_applications\n            WHERE user_id = $1\n            ORDER BY created_at DESC\n            LIMIT 1\n            ",
