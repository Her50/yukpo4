# Exemple de configuration Yukpo backend
# Copier en .env et adapter

DATABASE_URL=postgres://postgres:password@localhost:5432/yukpomnang
REDIS_URL=redis://127.0.0.1:6379/0
MONGODB_URL=mongodb://localhost:27017/yukpomnang
UPLOAD_STORAGE_PATH=./uploads

# Webhook alertes pipeline (Slack, PagerDuty, email…)
PIPELINE_ALERT_WEBHOOK=https://hooks.example.com/pipeline-alert
