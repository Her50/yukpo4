# Exemple de configuration Yukpo backend
# Copier en .env et adapter

DATABASE_URL=postgres://postgres:password@localhost:5432/yukpomnang
REDIS_URL=redis://127.0.0.1:6379/0
UPLOAD_STORAGE_PATH=./uploads

# Webhook alertes pipeline (Slack, PagerDuty, email…)
PIPELINE_ALERT_WEBHOOK=https://hooks.example.com/pipeline-alert

# === Paiements Africains (CinetPay / NotchPay) ===
CINETPAY_API_KEY=your_cinetpay_api_key
CINETPAY_SITE_ID=your_cinetpay_site_id
CINETPAY_SECRET_KEY=your_cinetpay_secret_key
NOTCHPAY_PUBLIC_KEY=your_notchpay_public_key
NOTCHPAY_SECRET_KEY=your_notchpay_secret_key

# === Flutterwave (Pan-Africain 30+ pays: M-Pesa Kenya, Airtel Uganda, Vodafone Ghana...) ===
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TESTxxxxxxxxxx
FLUTTERWAVE_WEBHOOK_HASH=your_flutterwave_webhook_hash

# === Stripe (Paiements Internationaux: Visa/Mastercard/Amex/Apple Pay/Google Pay) ===
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# === PayPal (Paiements Internationaux) ===
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_SANDBOX=true
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_RETURN_URL=https://yukpo.cm/api/webhooks/paypal/return
PAYPAL_CANCEL_URL=https://yukpo.cm/api/webhooks/paypal/cancel

