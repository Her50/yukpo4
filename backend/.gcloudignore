# .gcloudignore pour gcloud builds submit depuis backend/
# Exclut les fichiers lourds inutiles pour le build Docker GCP

# Build Rust (très lourd)
target/
target-check-tmp/

# Blender tar (trop lourd ~160MB, géré par le Dockerfile au runtime)
blender/*.tar.xz
blender/*.tar

# Fichiers temporaires
*.pdb
NONE
*.dSYM
*.swp
*.swo
*~
.DS_Store

# Docs (dossier uniquement — ne pas glob *.md car le Dockerfile en copie certains)
docs/

# Tools Windows (non nécessaires au build Linux)
tools/cloud-sql-proxy.exe

# Git
.git/
.gitignore
.gitattributes

# IDE
.vscode/
.idea/

# Logs
*.log
logs/
tmp/
temp/

# Tests locaux
tests/
test/
coverage/

# CI/CD
.github/
.gitlab-ci.yml

# Docker
docker-compose*.yml
